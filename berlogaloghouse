<div class="card">👨‍👩‍👧 Family Friendly</div>
<div class="card">📸 Perfect Photo Spots</div>
</div>
</div>
</section>

<section class="section stats">
<div class="container">
<div class="grid">
<div class="card"><h3>500+</h3><p>Guests</p></div>
<div class="card"><h3>4.9★</h3><p>Rating</p></div>
<div class="card"><h3>24/7</h3><p>Support</p></div>
<div class="card"><h3>100%</h3><p>Nature</p></div>
</div>
</div>
</section>

<section class="section gallery" id="gallery">
<div class="container">
