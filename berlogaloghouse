<a style="background:#588157" href="https://wa.me/37455350000">WhatsApp</a>
</div>
</div>
</div>
</section>

<footer>
<h3>Berloga Log House</h3>
<p>Luxury Guest House • Armenia</p>
</footer>

</body>
</html>
