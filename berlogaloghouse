<div class="grid">
<img src="photo1.jpg">
<img src="photo2.jpg">
<img src="photo3.jpg">
<img src="photo4.jpg">
<img src="photo5.jpg">
<img src="photo6.jpg">
</div>
</div>
</section>

<section class="section" id="reviews">
<div class="container">
<h2 class="title">Guest Reviews</h2>
<div class="grid">
<div class="card">★★★★★ Amazing atmosphere and views.</div>
<div class="card">★★★★★ Perfect getaway in Armenia.</div>
<div class="card">★★★★★ Beautiful log house and nature.</div>
</div>
</div>
</section>

<section class="section" id="contact">
<div class="container location">
<div>
<h2 class="title" style="text-align:left">Location</h2>
<iframe src="https://maps.google.com/maps?q=Berloga%20Log%20House&t=&z=13&ie=UTF8&iwloc=&output=embed" width="100%" height="450" style="border:0;border-radius:16px"></iframe>
</div>
<div>
<h2 class="title" style="text-align:left">Contact</h2>
<p>+374 55 350 000</p>
<p>+374 77 076 006</p>
<p>+374 99 650 000</p>
<div class="social">
<a style="background:#a98467" href="https://www.instagram.com/berloga_log_house/">Instagram</a>
